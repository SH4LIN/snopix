# Files and directories excluded from the WordPress.org distribution zip.
# See .github/workflows/release.yml — every pattern below is fed to rsync
# via --exclude-from.

# VCS / repository metadata
.git
.gitignore
.gitattributes
.github

# Editor / OS metadata
.vscode
.idea
.DS_Store
*.swp
*.swo
*~
Thumbs.db

# Local dev environments
.wp-env
.wp-env.json
wp-env.override.json
.env
.env.*
.env.example

# Build tooling at the repo root
node_modules
package.json
package-lock.json
yarn.lock
tsconfig.json
tsconfig.node.json
env.d.ts
playwright.config.ts

# Composer (plugin uses its own autoloader; no runtime deps)
composer.json
composer.lock
vendor

# Lint / static-analysis configs
phpcs.xml
phpcs.xml.dist
phpstan.neon
phpstan.neon.dist
phpstan-bootstrap.php
.phpcs-cache
.phpunit.result.cache

# Test suite
tests
phpunit.xml
phpunit.xml.dist
playwright-report
test-results
coverage
.nyc_output

# App source tree (admin, search, editor, shared) — only the built assets/ ships
app

# Documentation / scratch files that don't belong in the deployed plugin
README.md
CONTRIBUTING.md
TEST_REPORT.md
plan.md
design
design-preview.png
docs

# Dev databases & misc artifacts
ruvector.db
agentdb.rvf
agentdb.rvf.lock
*.log
setup-tests.sh
docker-compose.yml
.playwright-mcp
.claude

# Anything starting with a dot at the build root
.distignore

# WordPress.org assets folder — banners/icons are uploaded to SVN /assets/, not shipped in the plugin zip
.wordpress-org

# Test bootstrap config
wp-tests-config.php

# Prettier config
.prettierrc
.prettierrc.*
.prettierignore

# Build script — only needed during release, not at runtime
bin
